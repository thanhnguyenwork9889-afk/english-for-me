# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Supabase → Connect → ORMs / Connection string
# Transaction pooler (port 6543) — used by the app at runtime
DATABASE_URL=postgresql://postgres.your-project-ref:[PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres
# Session pooler or direct (port 5432) — used by drizzle-kit migrations
DATABASE_URL_DIRECT=postgresql://postgres.your-project-ref:[PASSWORD]@aws-0-region.pooler.supabase.com:5432/postgres

# Public URL of the app (used for magic-link redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Web Push — generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services: an https URL or mailto: address
VAPID_SUBJECT=https://github.com/your-name/english-for-me

# Shared secret for /api/cron/reminders (called by Supabase pg_cron). Any long random string:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
